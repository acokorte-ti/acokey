# Modelo do .env. No servidor: copie para .env, troque os valores e rode "chmod 600 .env".
# O .env NUNCA entra no repositório.

APP_ENV=producao
APP_DOMAIN=acokey.acokorte.com.br
# Porta local onde o site fica (o nginx do servidor faz o HTTPS e encaminha para ela)
WEB_PORTA=8093

# --- PostgreSQL (contêiner "db", sem porta exposta) ---
POSTGRES_DB=acokey
POSTGRES_USER=acokey
POSTGRES_PASSWORD=TROQUE_AQUI
DATABASE_URL=postgresql+psycopg://acokey:TROQUE_AQUI@db:5432/acokey

# --- Primeiro administrador (criado só quando não existe nenhum administrador) ---
ADMIN_LOGIN=admin
ADMIN_NOME=Administrador
ADMIN_SENHA_INICIAL=TROQUE_AQUI

# --- Sessão e login ---
SESSAO_HORAS=12
SESSAO_MAX_DIAS=7
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# --- Mega (Oracle, SOMENTE LEITURA, usuário próprio deste sistema: acokey_ro) ---
# DSN, usuário e senha são gravados por deploy/configurar_mega.sh. Com MEGA_HABILITADO=true, o botão "Buscar no
# Mega" (Cadastros > Ordens de produção) e o cron do servidor atualizam as OPs.
MEGA_HABILITADO=false
MEGA_DSN=
MEGA_USUARIO=
MEGA_SENHA=
# MEGA_FILIAL=3
# MEGA_OPS_DESDE=2024-01-01
